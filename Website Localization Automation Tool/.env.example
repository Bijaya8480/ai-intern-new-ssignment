# --- Environment variables for the Website Localization Automation Tool ---
# Copy this file to `.env` and adjust. Backend loads `.env` from the working dir.

# Application
APP_ENV=development          # development | production
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (SQLite default; switch to PostgreSQL in production)
DATABASE_URL=sqlite:///./loc_tool.db

# Crawler
MAX_CRAWL_PAGES=50
MAX_CRAWL_DEPTH=5
CRAWL_TIMEOUT=30000
USE_PLAYWRIGHT=true

# AI translation. Set GOOGLE_CLOUD_TRANSLATE_KEY to enable production-grade
# translation via the official Google Cloud Translation API. Without any cloud
# key, the backend falls back to the free Google Translate (deep-translator)
# engine when USE_GOOGLE_TRANSLATE=true.
LLM_PROVIDER=openrouter      # openrouter | openai
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
# Use Google Translate (free, via deep-translator) as a fallback translation
# engine when GOOGLE_CLOUD_TRANSLATE_KEY is not set.
USE_GOOGLE_TRANSLATE=true
# Google Cloud Translation API (official Google Cloud AI service).
# Paste a server API key here to enable production-grade multi-language
# translation. When set it takes priority over the free Google Translate engine.
GOOGLE_CLOUD_TRANSLATE_KEY=

# Brand names that must never be translated (comma separated)
BRAND_NAMES=AcmeCorp,Acme,ExampleCorp

# Publishing: base URL embedded in the generated JS snippet
PUBLISHER_BASE_URL=http://localhost:8000
